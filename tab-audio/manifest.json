{
  "manifest_version": 3,
  "name": "탭 소리 녹음",
  "version": "0.1.0",
  "description": "지금 보고 있는 탭에서 나오는 소리를 WAV 파일로 녹음합니다.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "activeTab"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "탭 소리 녹음",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
